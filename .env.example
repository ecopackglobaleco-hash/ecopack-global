# ─── Notification Email ───────────────────────────────────────────────────────
# Email address that receives new lead notifications
NOTIFICATION_EMAIL=

# ─── Admin Dashboard ─────────────────────────────────────────────────────────
# Password to access /admin lead dashboard
ADMIN_PASSWORD=
